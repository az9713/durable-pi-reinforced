# Copy to .env at the repo root. `just net up <id>` copies the keys listed under
# `env_keys` in dpi-network.yaml into each device's ~/.dpi/backend.env.
OPENROUTER_API_KEY=sk-or-...

# Optional: call Jev through TypeSafe directly instead of OpenRouter (jev-damage-control and
# the proactive demo). Add it to `env_keys` in dpi-network.yaml to send it to your devices.
# TYPESAFE_API_KEY=

# Only for apps/proactive-dpi-demo (text-to-speech announcements). Without it the demo runs silently.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=56bWURjYFHyYyVf490Dp   # any voice in your ElevenLabs account
# ELEVENLABS_MODEL=eleven_v4_turbo
# DPI_READY_SPEECH="Engineer, your Durable Agent Red Team found a production issue, and found the fix. It's waiting on your review."
# DPI_OPENED_SPEECH="Engineer, heads up. Jev flagged a production issue in {service}. A durable agent is investigating."
