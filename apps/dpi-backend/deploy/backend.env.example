# ~/.dpi/backend.env (mode 0600). `just net up <device>` writes this for you.
DPI_TOKEN=dpi_replace_with_32_random_bytes_base64url
DPI_DEVICE_NAME=my-device
DPI_PORT=4780
# 127.0.0.1 (the default) serves this machine only. ssh and exe-dev devices use 0.0.0.0 so clients and the exe.dev proxy can reach them.
DPI_HOST=127.0.0.1
# Colon-separated folders where new sessions start, created if missing (default ~/dpi-work).
DPI_START_DIRS=~/dpi-work
OPENROUTER_API_KEY=sk-or-...
